# macOS Zotero 10 development setup. Copy this file to .env.
# Use separate profile and data directories; .scaffold is gitignored.
ZOTERO_PLUGIN_ZOTERO_BIN_PATH = /Applications/Zotero.app/Contents/MacOS/zotero
ZOTERO_PLUGIN_PROFILE_PATH = .scaffold/dev-profile
ZOTERO_PLUGIN_DATA_DIR = .scaffold/dev-data

# The scaffold already stops the instance it launches. This prevents its
# fallback shutdown command from terminating unrelated Zotero instances.
ZOTERO_PLUGIN_KILL_COMMAND = true
